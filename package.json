{
  "name": "parchment",
  "version": "1.0.1",
  "description": "A fast, private, open-source Markdown viewer for macOS, Windows, and Linux",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scrypt-kitty/parchment.git"
  },
  "bugs": {
    "url": "https://github.com/scrypt-kitty/parchment/issues"
  },
  "homepage": "https://github.com/scrypt-kitty/parchment#readme",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "start": "tauri dev",
    "bundle": "tauri build",
    "test": "node test/render.test.mjs",
    "test:coverage": "c8 --reporter=text --reporter=lcov --include='src/**' --check-coverage --lines 95 --functions 95 --branches 80 node test/render.test.mjs",
    "validate": "npm run test:coverage && tsc --noEmit && npm run lint:rust",
    "lint:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "dompurify": "^3.2.4",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-task-lists": "^2.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "c8": "^12.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
